# Crawler configuration. Copy to .env and fill in real values.
# .env holds secrets and is gitignored — never commit real credentials here.

# HTTP
CRAWLER_PORT=8001
# CRAWLER_USER_AGENT=
# CRAWLER_REQUEST_TIMEOUT=20

# Threads: use a persistent browser instead of raw httpx
CRAWLER_THREADS_USE_BROWSER=true
# Persistent, logged-in browser profile directory (provision once manually).
# Leave unset to use an ephemeral (anonymous) browser context.
# CRAWLER_THREADS_BROWSER_PROFILE=
CRAWLER_THREADS_BROWSER_LOCALE=id-ID
CRAWLER_THREADS_BROWSER_TIMEZONE=Asia/Jakarta
CRAWLER_THREADS_ACCEPT_LANGUAGE=id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7

# Retry / wait behaviour
# CRAWLER_THREADS_BROWSER_TIMEOUT=30
# CRAWLER_THREADS_CONTENT_WAIT=45
# CRAWLER_THREADS_SEARCH_ATTEMPTS=3
# CRAWLER_THREADS_RETRY_BACKOFF_SECONDS=1

# Optional forward proxy for the browser (leave all blank to disable).
CRAWLER_THREADS_PROXY_SERVER=
CRAWLER_THREADS_PROXY_USERNAME=
CRAWLER_THREADS_PROXY_PASSWORD=
