DATABASE_URL=postgresql://threads:threads@localhost:5432/threads_dev?schema=public
REDIS_URL=redis://localhost:6379
OPENAI_API_KEY=
CRAWLER_API_URL=http://localhost:8001
CRAWLER_TIMEOUT=300
CRAWLER_CONCURRENCY=4
WEB_PORT=3000
API_PORT=3001
CRAWLER_PORT=8001
JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Auth multi-user ---
# Opsional: kalau kosong diturunkan dari JWT_SECRET (label berbeda per jenis token).
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
# Base URL web, dipakai untuk link reset password di email.
APP_URL=http://localhost:3000

# --- Email (reset password) ---
# Kosongkan SMTP_HOST di dev: isi email dicetak ke log API, tidak dikirim.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Threads Research <no-reply@example.com>"

# --- Auto-publish ---
AUTO_PUBLISH_ENABLED=true
AUTO_PUBLISH_INTERVAL_MS=120000
AUTO_PUBLISH_WINDOW_HOURS=24
AUTO_PUBLISH_THRESHOLD=0.85
