generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum CrawlJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum TopicStatus {
  ACTIVE
  ARCHIVED
}

enum AffiliateContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  name            String?
  email           String    @unique
  passwordHash    String?
  // Akun Threads milik user, dipakai auto-publish untuk mencari post-nya.
  threadsUsername String?
  // Refresh/reset token yang terbit sebelum waktu ini ditolak: mengganti
  // password otomatis mencabut semua sesi lama dan link reset yang sudah dipakai.
  passwordChangedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  topics            Topic[]
  templates         Template[]
  affiliateContents AffiliateContent[]
  affiliateLinks    AffiliateLink[]
}

model Topic {
  id        String      @id @default(uuid())
  keyword   String
  status    TopicStatus @default(ACTIVE)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  posts       ThreadPost[]
  crawlJobs   CrawlJob[]
  contents    AffiliateContent[]
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String

  @@index([userId])
  @@index([keyword])
  @@index([userId, keyword])
}

model ThreadPost {
  id                 String   @id @default(uuid())
  externalId         String
  authorUsername     String
  authorDisplayName  String?
  authorAvatarUrl    String?
  content            String
  mediaUrls          String[] @default([])
  likeCount          Int      @default(0)
  replyCount         Int      @default(0)
  repostCount        Int      @default(0)
  sourceUrl          String
  publishedAt        DateTime?
  relevanceScore     Float?
  affiliateScore     Float?
  crawledAt          DateTime @default(now())

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  affiliateContents AffiliateContent[]

  @@unique([topicId, externalId])
  @@index([topicId])
  @@index([relevanceScore])
}

model Template {
  id         String   @id @default(uuid())
  name       String
  content    String
  variables  Json?
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  affiliateContents AffiliateContent[]
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String

  // Nullable karena template lama dibuat sebelum katalog link ada; API
  // mewajibkan linkId pada create/update baru.
  linkId String?
  link   AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@unique([userId, name])
  @@index([userId])
  @@index([linkId])
}

// Katalog link produk affiliate yang dipakai ulang lintas template/draft.
// Berdiri sendiri untuk sekarang: belum ada relasi ke Template/AffiliateContent
// (lihat keputusan "Link berdiri sendiri dulu"), jadi menghapus link tidak
// memengaruhi konten yang sudah digenerate.
model AffiliateLink {
  id        String   @id @default(uuid())
  name      String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Hapus link tidak menghapus template/draft: referensinya di-set NULL.
  // Teks draft tetap utuh karena URL-nya sudah tertanam saat digenerate.
  templates         Template[]
  affiliateContents AffiliateContent[]

  @@unique([userId, name])
  @@index([userId])
}

model AffiliateContent {
  id            String                   @id @default(uuid())
  product       String
  category      String?
  context       String?
  affiliateLink String?
  content       String
  status        AffiliateContentStatus   @default(DRAFT)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  // Auto-publish: diisi saat job menemukan post asli di profil sendiri.
  // publishedAt juga diisi kalau user menandai terkirim manual.
  publishedAt     DateTime?
  postUrl         String?
  autoPublishedAt DateTime?

  templateId String
  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)

  topicId String?
  topic   Topic?    @relation(fields: [topicId], references: [id], onDelete: SetNull)

  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Link balasan yang di-paste user setelah posting manual; username di
  // dalamnya dipakai auto-publish sebelum jatuh ke User.threadsUsername.
  replyLink String?

  threadPostId String?
  threadPost   ThreadPost? @relation(fields: [threadPostId], references: [id], onDelete: SetNull)

  linkId String?
  link   AffiliateLink? @relation(fields: [linkId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@index([topicId])
  @@index([userId])
  @@index([threadPostId])
  @@index([linkId])
  // Job auto-publish: ambil draft yang masih DRAFT, terbaru dulu.
  @@index([status, createdAt])
  @@index([userId, status, createdAt])
}

model CrawlJob {
  id         String         @id @default(uuid())
  status     CrawlJobStatus @default(QUEUED)
  progress   Int            @default(0)
  total      Int            @default(0)
  error      String?
  startedAt  DateTime?
  finishedAt DateTime?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@index([topicId])
  @@index([status])
}
